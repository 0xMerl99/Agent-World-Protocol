{
  "name": "agent-world-protocol",
  "version": "0.3.0",
  "description": "A live, multiplayer pixel world played by real people — move, gather, build, fight, trade, and form guilds.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "npx nodemon",
    "test": "node test/test-world.js",
    "test:watch": "npx nodemon --watch src --watch test --exec \"node test/test-world.js\"",
    "lint": "npx eslint src/ --fix",
    "validate": "node -e \"require('./src/server/WorldState'); console.log('OK: all modules load')\""
  },
  "keywords": [
    "multiplayer",
    "game",
    "pixel-art",
    "solana",
    "world-server",
    "mmo"
  ],
  "author": "Adrian",
  "license": "MIT",
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.0",
    "pg": "^8.20.0",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  }
}
